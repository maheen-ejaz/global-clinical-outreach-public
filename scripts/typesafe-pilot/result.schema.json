{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated TypeSafe synthetic pilot result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "attempt_id",
    "stimulus_id",
    "variant",
    "outcome",
    "model",
    "usage",
    "estimated_usage_cost_usd",
    "client_request_ms",
    "provider_model_time_ms",
    "provider_model_time_note",
    "elapsed_from_run_start_ms",
    "received_at",
    "no_update",
    "requires_human_review"
  ],
  "properties": {
    "protocol_id": { "const": "gco-window-status-synthetic-v2" },
    "attempt_id": { "type": "string" },
    "stimulus_id": { "type": "string" },
    "variant": { "enum": ["base", "permuted"] },
    "outcome": { "enum": ["validated", "safe_error"] },
    "model": { "const": "jev-1.13.0" },
    "window_status": {
      "oneOf": [
        { "$ref": "#/$defs/choiceAnswer" },
        { "type": "null" }
      ]
    },
    "evidence_id": {
      "oneOf": [
        { "$ref": "#/$defs/choiceAnswer" },
        { "type": "null" }
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_id", "source_url", "exact_paragraph"],
          "properties": {
            "candidate_id": { "type": "string" },
            "source_url": { "type": "string", "pattern": "^https://synthetic\\.example/" },
            "exact_paragraph": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "usage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    },
    "estimated_usage_cost_usd": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "client_request_ms": { "type": "integer", "minimum": 0, "maximum": 31000 },
    "provider_model_time_ms": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "provider_model_time_note": { "type": "string" },
    "elapsed_from_run_start_ms": { "type": "integer", "minimum": 0 },
    "received_at": { "type": "string", "format": "date-time" },
    "no_update": { "const": true },
    "requires_human_review": { "const": true },
    "error_code": {
      "enum": [
        "REQUEST_TIMEOUT",
        "REQUEST_FAILED",
        "HTTP_REJECTED",
        "INVALID_RESPONSE",
        "POSITIVE_STATUS_WITHOUT_EVIDENCE"
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "validated" } } },
      "then": {
        "required": ["window_status", "evidence_id", "evidence"],
        "properties": {
          "window_status": { "$ref": "#/$defs/choiceAnswer" },
          "evidence_id": { "$ref": "#/$defs/choiceAnswer" },
          "usage": { "type": "object" },
          "error_code": false
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "safe_error" } } },
      "then": {
        "required": ["error_code"],
        "properties": {
          "evidence": { "type": "null" },
          "window_status": {
            "oneOf": [
              { "$ref": "#/$defs/choiceAnswer" },
              { "type": "null" }
            ]
          },
          "evidence_id": {
            "oneOf": [
              { "$ref": "#/$defs/choiceAnswer" },
              { "type": "null" }
            ]
          },
          "usage": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_tokens", "output_tokens"],
                "properties": {
                  "input_tokens": { "type": "integer", "minimum": 0 },
                  "output_tokens": { "type": "integer", "minimum": 0 }
                }
              },
              { "type": "null" }
            ]
          },
          "estimated_usage_cost_usd": {
            "oneOf": [
              { "type": "number", "minimum": 0 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": { "const": "safe_error" },
          "error_code": { "const": "POSITIVE_STATUS_WITHOUT_EVIDENCE" }
        }
      },
      "then": {
        "required": ["window_status", "evidence_id", "usage"],
        "properties": {
          "window_status": { "$ref": "#/$defs/choiceAnswer" },
          "evidence_id": { "$ref": "#/$defs/choiceAnswer" },
          "usage": { "type": "object" },
          "estimated_usage_cost_usd": { "type": "number", "minimum": 0 },
          "evidence": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "choiceAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice", "probabilities", "confidence"],
      "properties": {
        "choice": { "type": "string" },
        "probabilities": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
